# REST API base (dev tunnel or production)
API_BASE_URL=https://YOUR-TUNNEL-ID.inc1.devtunnels.ms/api/

# Customer table QR menu (optional — if empty, uses API_BASE_URL + /qr-menu/menu)
# Examples:
# QR_MENU_BASE_URL=https://YOUR-TUNNEL-ID.inc1.devtunnels.ms/api/qr-menu/menu
# QR_MENU_BASE_URL=https://api.billkrochillkro.com/api/qr-menu/menu

# KDS real-time WebSocket
# - false: use same host as API_BASE_URL (production / remote-only)
# - true: connect to local billkaro-backend (for dev tunnel REST + local Nest WS)
KDS_WS_USE_LOCAL=false
KDS_WS_LOCAL_PORT=3000

# Razorpay Configuration
# Copy this file to .env and replace with your actual Razorpay keys
# Test keys: https://dashboard.razorpay.com/app/keys
# Production keys: https://dashboard.razorpay.com/app/keys (switch to live mode)

RAZORPAY_KEY_TEST=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_PRODUCTION=rzp_live_xxxxxxxxxxxxx
RAZORPAY_ENVIRONMENT=test
# Merchant UPI linked to your Razorpay account (wallet / checkout UPI QR)
RAZORPAY_MERCHANT_UPI_ID=9582222724@pthdfc

# GSTIN verification (gstincheck.co.in)
GST_API_KEY=your_gstincheck_api_key
# GEMINI_API_KEY=your_google_ai_studio_key

# Optional: Cloud OCR fallback API key (defaults to free tier if omitted)
# OCR_SPACE_API_KEY=your_ocr_space_key

# Twilio (OTP SMS on server + WhatsApp Marketing bulk send in app)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
# Production WhatsApp sender (your approved business number).
# Do NOT use the Twilio sandbox (+14155238886) — customers would need to send "join ..." first.
TWILIO_WHATSAPP_NUMBER=whatsapp:+15722213443