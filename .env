# REST API (dev tunnel — update when tunnel URL changes)
API_BASE_URL=https://nmsmfkdd-3000.inc1.devtunnels.ms/api/
# API_BASE_URL=https://api.billkrochillkro.com/api/

# Customer table QR menu (optional — leave commented to use API_BASE_URL + /qr-menu/menu)
QR_MENU_BASE_URL=https://nmsmfkdd-3000.inc1.devtunnels.ms/api/qr-menu/menu

# KDS WebSocket: on Windows, connect to local Nest (port must match billkaro-backend .env PORT)
KDS_WS_USE_LOCAL=true
KDS_WS_LOCAL_PORT=3000

